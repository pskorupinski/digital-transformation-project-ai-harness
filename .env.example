# Copy to .env (never committed). docker-compose passes it to the backend.

# Default mode for every external capability (D-01):
#   fake = in-process fake adapters (v0)    real = real vendor adapters (v1)
INTEGRATIONS_MODE=fake

# Per-capability override: <CAPABILITY>_MODE beats INTEGRATIONS_MODE.
# AI (D-05): real model in v0 is fine — tests always use the fake.
# AI_MODE=real
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5
